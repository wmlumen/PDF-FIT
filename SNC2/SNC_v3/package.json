{
  "name": "snc-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/validator.test.mjs && node tests/export.test.mjs && node tests/workflow.test.mjs && node tests/geometry-history.test.mjs && node tests/cogo.test.mjs && node tests/lineage.test.mjs && node tests/topology-repair.test.mjs && node tests/versioning.test.mjs && node tests/geoprocessing.test.mjs && node tests/segment-lengths.test.mjs && node tests/api-security.test.mjs",
    "start": "node server-api.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "audit:sync": "node scripts/sync-auditoria.mjs",
    "audit:graph": "python scripts/graphify_index_docs.py docs/AUDITORIA_SNC_v3_2026-10-18.md docs/PLAN_REMEDIACION_AUDITORIA.md",
    "predeploy": "bash scripts/promotion_gate.sh && npm test",
    "deploy": "firebase deploy --only hosting,functions",
    "deploy:all": "npm run predeploy && npm run deploy",
    "preview": "firebase hosting:channel:deploy preview",
    "backup:db": "bash scripts/backup_sqlite.sh",
    "restore:db": "bash scripts/restore_sqlite.sh",
    "rotate:legacy": "bash scripts/rotate_legacy_hashes.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.12.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "graphify": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.1.7",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "dxf-parser": "^1.1.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "proj4": "^2.22.0",
    "shp-write": "^0.3.2",
    "shpjs": "^6.2.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "xlsx": "^0.18.5"
  }
}
