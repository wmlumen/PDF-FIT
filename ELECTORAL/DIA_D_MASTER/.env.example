# DIA D MASTER - Variables de Entorno
# Copiar a .env y ajustar según necesidad

# Servidor
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Base de datos (SQLite - default)
DATABASE_PATH=database/ddia.db

# Seguridad
# Clave secreta para firmar tokens (generar con: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=
# Iteraciones para hash de contraseñas PBKDF2
HASH_ITERATIONS=100000
# Minutos de expiración de sesión (default: 120)
SESSION_TIMEOUT_MINUTES=120
# Intentos de login permitidos por ventana de tiempo
RATE_LIMIT_LOGIN_MAX=5
# Ventana de rate limiting en segundos
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (origenes permitidos, separados por coma - vacío = sin restricción)
CORS_ORIGINS=

# Push Notifications (VAPID Keys - obtener de https://firebase.google.com/docs/web/setup)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# API Keys Dirigentes
DIRE_API_KEY=

# Token para operaciones POST de veedores (requerido para levantar el servidor)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
VEEDOR_POST_TOKEN=

# Modo
ENVIRONMENT=development  # development o production

# URL pública del sitio (para armar enlaces directos en emails/WhatsApp, ej. recuperar
# contraseña, link de recogida de votante). En producción: https://yocreo-2570b.web.app
# En desarrollo local, dejar http://localhost:8000.
BASE_URL=http://localhost:8000

# Email de bienvenida/acceso al cliente (SMTP). Funciona con Gmail (requiere
# "contraseña de aplicación", no la contraseña normal de la cuenta), SendGrid,
# Mailgun, etc. Si se dejan vacías, el email simplemente no se envía (se loguea).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS / WhatsApp de bienvenida al cliente (Twilio). Crear cuenta en
# https://www.twilio.com — tiene prueba gratis. Para WhatsApp hay que activar
# el sandbox o un número de WhatsApp Business dentro de Twilio.
# Si se dejan vacías, no se envía (se loguea).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
